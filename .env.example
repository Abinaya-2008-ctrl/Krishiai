# KrishiAI Environment Configuration (Sample Placeholder)
# All basic features operate fully locally without any paid API keys.

# Environment: development / production
ENVIRONMENT=development

# Optional custom database path (defaults to ./krishiai.db if not specified)
# KRISHIAI_DB_PATH=krishiai.db

# Optional Open-Meteo User Agent or Commercial Key (Defaults to free open-source tier)
# OPEN_METEO_API_KEY=
